{
  "format": "custom",
  "id": "service",
  "label": "Service",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": { "type": "UID", "config": { "label": "UID" } },
      "title": { "type": "Text", "config": { "label": "Title" } },
      "eyebrow": { "type": "Text", "config": { "label": "Eyebrow" } },
      "summary": { "type": "Text", "config": { "label": "Summary" } },
      "lead": { "type": "StructuredText", "config": { "label": "Lead", "multi": "paragraph,strong,em,hyperlink" } },
      "hero_image": { "type": "Image", "config": { "label": "Hero image", "constraint": {}, "thumbnails": [] } },
      "card_image": { "type": "Image", "config": { "label": "Card image", "constraint": {}, "thumbnails": [] } },
      "benefits": {
        "type": "Group",
        "config": {
          "label": "Benefits",
          "fields": {
            "benefit": { "type": "Text", "config": { "label": "Benefit" } }
          }
        }
      },
      "process": {
        "type": "Group",
        "config": {
          "label": "Process",
          "fields": {
            "step": { "type": "Text", "config": { "label": "Step" } }
          }
        }
      },
      "pricing": {
        "type": "Group",
        "config": {
          "label": "Pricing",
          "fields": {
            "label": { "type": "Text", "config": { "label": "Label" } },
            "value": { "type": "Text", "config": { "label": "Value" } },
            "note": { "type": "Text", "config": { "label": "Note" } }
          }
        }
      },
      "faq": {
        "type": "Group",
        "config": {
          "label": "FAQ",
          "fields": {
            "question": { "type": "Text", "config": { "label": "Question" } },
            "answer": { "type": "Text", "config": { "label": "Answer" } }
          }
        }
      },
      "related_services": {
        "type": "Group",
        "config": {
          "label": "Related services",
          "fields": {
            "service": { "type": "Link", "config": { "label": "Service", "select": "document", "customtypes": ["service"] } }
          }
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "Gallery",
          "fields": {
            "image": { "type": "Image", "config": { "label": "Image", "constraint": {}, "thumbnails": [] } },
            "alt": { "type": "Text", "config": { "label": "Alt" } }
          }
        }
      },
      "seo_title": { "type": "Text", "config": { "label": "SEO title" } },
      "seo_description": { "type": "Text", "config": { "label": "SEO description" } }
    }
  }
}
