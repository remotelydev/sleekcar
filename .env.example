NEXT_PUBLIC_SITE_URL=https://sleek-car.pl
NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=
PRISMIC_REVALIDATE_SECRET=

# --- Panel właściciela /panel (docs/panel-rolki.md) ---
# Wygeneruj: node scripts/panel-setup.mjs
PANEL_PASSWORD_HASH=
PANEL_TOTP_SECRET=
PANEL_SESSION_SECRET=

# Prismic > Settings > API & Security > Write APIs > token
PRISMIC_WRITE_TOKEN=

# Instagram Graph API (konto firmowe/twórcy połączone ze stroną na Facebooku)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Opcjonalnie: graph.instagram.com przy tokenie z "Instagram Login"
INSTAGRAM_GRAPH_HOST=graph.facebook.com
INSTAGRAM_GRAPH_VERSION=v23.0

# TikTok Content Posting API (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# direct = publikacja od razu, inbox = szkic w aplikacji TikTok
TIKTOK_POST_MODE=direct
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Opcjonalnie, zamiast przycisku "Połącz TikTok" w panelu
TIKTOK_REFRESH_TOKEN=
